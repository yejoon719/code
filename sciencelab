        body {
            font-family: 'Noto Sans KR', sans-serif;
            background-color: #f0f5ff;
            color: #0f172a;
            overflow-x: hidden;
            word-break: keep-all;
            overflow-wrap: break-word;
        }

        .chart-container {
            position: relative;
            width: 100%;
            max-width: 680px;
            margin-left: auto;
            margin-right: auto;
            height: 350px;
            max-height: 400px;
        }
        @media (min-width: 768px) {
            .chart-container {
                height: 380px;
            }
        }
        
        /* Interactive Animations & Transitions */
        .interactive-card {
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), 
                        box-shadow 0.25s ease, 
                        border-color 0.25s ease;
        }
        .interactive-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px -6px rgba(37, 99, 235, 0.18);
            border-color: #93c5fd;
        }

        .interactive-btn {
            transition: all 0.2s ease;
        }
        .interactive-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
        }
        .interactive-btn:active {
            transform: translateY(1px) scale(0.98);
        }

        /* Table Row Animation (No Scale to prevent scrollbars) */
        .table-row-interactive {
            transition: background-color 0.15s ease, border-color 0.15s ease;
        }
        .table-row-interactive:hover {
            background-color: #e0f2fe;
        }

        /* Pulse glow for value updates */
        @keyframes valuePop {
            0% { transform: scale(1); }
            50% { transform: scale(1.08); color: #1d4ed8; }
            100% { transform: scale(1); }
        }
        .value-updated {
            animation: valuePop 0.3s ease-out;
        }

        /* Visible Range Slider Track & Thumb Styling */
        input[type=range] {
            -webkit-appearance: none;
            width: 100%;
            background: transparent;
        }
        input[type=range]:focus {
            outline: none;
        }
        input[type=range]::-webkit-slider-runnable-track {
            width: 100%;
            height: 10px;
            cursor: pointer;
            background: #cbd5e1;
            border-radius: 6px;
            border: 1px solid #94a3b8;
        }
        input[type=range]::-moz-range-track {
            width: 100%;
            height: 10px;
            cursor: pointer;
            background: #cbd5e1;
            border-radius: 6px;
            border: 1px solid #94a3b8;
        }
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 24px;
            width: 24px;
            border-radius: 50%;
            background: #2563eb;
            cursor: pointer;
            margin-top: -8px;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.25);
            transition: transform 0.15s ease, background-color 0.15s ease;
        }
        input[type=range]::-webkit-slider-thumb:hover {
            transform: scale(1.15);
            background: #1d4ed8;
            box-shadow: 0 0 0 6px rgba(37, 99, 235, 0.35);
        }
        input[type=range]::-moz-range-thumb {
            height: 22px;
            width: 22px;
            border-radius: 50%;
            background: #2563eb;
            cursor: pointer;
            border: none;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.25);
        }

        #oohoCanvas {
            background: radial-gradient(circle, #ffffff 0%, #eff6ff 100%);
            border-radius: 0.75rem;
        }

        /* Nav Tab active state indicator */
        .nav-tab-btn {
            position: relative;
            transition: color 0.2s ease, background-color 0.2s ease;
        }
        .nav-tab-btn.active {
            color: #1d4ed8;
            font-weight: 700;
            background-color: #dbeafe;
        }

        /* Page Side Slide Animation */
        @keyframes slideInFromRight {
            0% {
                opacity: 0;
                transform: translateX(40px);
            }
            100% {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .page-view {
            display: none;
        }
        .page-view.active-page {
            display: block;
            animation: slideInFromRight 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Gentle Bounce Animation for Scroll Down Arrow */
        @keyframes scrollBounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(8px); }
        }
        .animate-scroll-bounce {
            animation: scrollBounce 2s infinite ease-in-out;
        }
    </style>
</head>
