            <p class="font-medium text-slate-600">고등학생용 자성 오호 실험 계획 및 데이터 정량 시뮬레이션 인터랙티브 리포트</p>
            <p>화학Ⅱ (고분자 및 이온 결합) &amp; 물리Ⅰ (자기장과 자성체) 교과 연계</p>
        </div>
    </footer>

    <!-- JavaScript Application Logic -->
    <script>
        // Data model
        const sampleData = [
            { conc: 0.5, dist: 0.5, load: 170, status: "구형 유지 / 자성 거의 없음", alertClass: "bg-blue-50/50 text-slate-700 border-blue-100" },
            { conc: 1.0, dist: 1.2, load: 150, status: "샘플 A: 표면 매끄럽고 구형 유지, 강한 내구성", alertClass: "bg-blue-50 text-blue-800 border-blue-200" },
            { conc: 2.0, dist: 2.0, load: 125, status: "구형 안정적, 자성 응답성 양호", alertClass: "bg-blue-50 text-blue-800 border-blue-200" },
            { conc: 3.0, dist: 2.8, load: 95,  status: "샘플 B: 최적의 자성 응답성 및 구형 내구성 균형 (Trade-off Optimum)", alertClass: "bg-blue-100 text-blue-900 border-blue-300 font-bold" },
            { conc: 4.0, dist: 3.6, load: 60,  status: "자성 강함 / 막의 두께가 약해지기 시작함", alertClass: "bg-sky-50 text-sky-800 border-sky-200" },
            { conc: 5.0, dist: 4.5, load: 35,  status: "샘플 C: 자석에 즉시 끌려오나 경미한 압력에도 쉽게 파열됨", alertClass: "bg-indigo-50 text-indigo-900 border-indigo-200" },
            { conc: 6.0, dist: 5.2, load: 15,  status: "자성 매우 강함 / 겔 형성 불량 및 형상 붕괴 위험", alertClass: "bg-indigo-100 text-indigo-950 border-indigo-300 font-bold" }
        ];

        // UI elements
        const concSlider = document.getElementById('concSlider');
        const concValue = document.getElementById('concValue');
        const calcDistance = document.getElementById('calcDistance');
        const calcLoad = document.getElementById('calcLoad');
        const statusAlert = document.getElementById('statusAlert');
        const canvas = document.getElementById('oohoCanvas');
        const ctx = canvas.getContext('2d');

        let tradeoffChart = null;

        // Interactive animation state variables
        let animFrameId = null;
        let currentConcSmooth = 3.0;
        let animTime = 0;

        // Smooth Scroll to Menu Section on Home Page
        function scrollToMenu() {
            const menuElem = document.getElementById('home-menu-section');
            if (menuElem) {
                menuElem.scrollIntoView({ behavior: 'smooth' });
            }
        }

        // Page Navigation Switcher with Side-Slide Effect
        function switchPage(pageId) {
            // Hide all pages
            const pages = document.querySelectorAll('.page-view');
            pages.forEach(p => {
                p.classList.remove('active-page');
            });

            // Remove active class from nav tabs
            const tabs = document.querySelectorAll('.nav-tab-btn');
            tabs.forEach(t => t.classList.remove('active'));

            // Show selected page and trigger side slide animation
            const targetPage = document.getElementById(`page-${pageId}`);
            if (targetPage) {
                // Reflow trick to restart animation reliably
                void targetPage.offsetWidth;
                targetPage.classList.add('active-page');
            }

            // Set active tab
            const targetTab = document.getElementById(`nav-${pageId}`);
            if (targetTab) {
                targetTab.classList.add('active');
            }

            // Scroll to top smooth
            window.scrollTo({ top: 0, behavior: 'smooth' });

            // If switching to simulator, trigger chart resize to avoid rendering issues
            if (pageId === 'simulator' && tradeoffChart) {
                setTimeout(() => {
                    tradeoffChart.resize();
                }, 50);
            }
        }

        // Helper to calculate interpolated values
        function getDataForConc(conc) {
            const exact = sampleData.find(d => d.conc === conc);
            if (exact) return exact;

            const dist = (0.3 + conc * 0.83).toFixed(1);
            const load = Math.max(10, Math.round(180 - conc * 28));
            let status = "자성과 구조적 강도 변화 중";
            let alertClass = "bg-blue-50/50 text-slate-800 border-blue-100";

            if (conc < 2.5) {
                status = "구형 유지 우수 / 자성 상대적 약함";
                alertClass = "bg-blue-50 text-blue-800 border-blue-200";
            } else if (conc <= 3.5) {
                status = "최적 권장 영역: 자성 반응성과 내구성의 조화";
                alertClass = "bg-blue-100 text-blue-900 border-blue-300 font-bold";
            } else {
                status = "입체 장애 증가로 교차결합 밀도 저하 / 파열 위험 가중";
                alertClass = "bg-indigo-50 text-indigo-900 border-indigo-200";
            }

            return { conc, dist, load, status, alertClass };
        }

        // Initialize Chart.js with Ocean Blue Theme
        function initChart() {
            const chartCtx = document.getElementById('tradeoffChart').getContext('2d');
            
            const labels = sampleData.map(d => `${d.conc}%`);
            const distData = sampleData.map(d => d.dist);
            const loadData = sampleData.map(d => d.load);

            tradeoffChart = new Chart(chartCtx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: '자력 반응 임계 거리 (d, cm)',
                            data: distData,
                            borderColor: '#2563eb',
                            backgroundColor: 'rgba(37, 99, 235, 0.12)',
                            borderWidth: 3,
                            yAxisID: 'yDist',
                            tension: 0.35,
                            pointRadius: sampleData.map(d => d.conc === 3.0 ? 8 : 5),
                            pointBackgroundColor: sampleData.map(d => d.conc === 3.0 ? '#1d4ed8' : '#2563eb'),
                            pointHoverRadius: 9
                        },
                        {
                            label: '임계 파열 하중 (W, g)',
                            data: loadData,
                            borderColor: '#0284c7',
                            backgroundColor: 'rgba(2, 132, 199, 0.12)',
                            borderWidth: 3,
                            yAxisID: 'yLoad',
                            tension: 0.35,
                            pointRadius: sampleData.map(d => d.conc === 3.0 ? 8 : 5),
                            pointBackgroundColor: sampleData.map(d => d.conc === 3.0 ? '#0369a1' : '#0284c7'),
                            pointHoverRadius: 9
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: {
                        duration: 300
                    },
                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: '산화철 농도 (wt%)',
                                font: { weight: 'bold', family: "'Noto Sans KR', sans-serif" }
                            }
                        },
                        yDist: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: {
                                display: true,
                                text: '반응 거리 (cm)',
                                color: '#2563eb',
                                font: { weight: 'bold', family: "'Noto Sans KR', sans-serif" }
                            },
                            min: 0,
                            max: 6
                        },
                        yLoad: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: {
                                display: true,
                                text: '파열 하중 (g)',
                                color: '#0284c7',
                                font: { weight: 'bold', family: "'Noto Sans KR', sans-serif" }
                            },
                            grid: {
                                drawOnChartArea: false
                            },
                            min: 0,
                            max: 200
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                font: { family: "'Noto Sans KR', sans-serif", size: 12 }
                            }
                        }
                    }
                }
            });
        }

        // Highlight Active Point in Chart.js
        function updateChartHighlight(targetConc) {
            if (!tradeoffChart) return;

            const pointRadii = sampleData.map(d => Math.abs(d.conc - targetConc) < 0.1 ? 9 : 4);
            const pointColors = sampleData.map(d => Math.abs(d.conc - targetConc) < 0.1 ? '#1e3a8a' : '#2563eb');
            const loadPointColors = sampleData.map(d => Math.abs(d.conc - targetConc) < 0.1 ? '#0c4a6e' : '#0284c7');

            tradeoffChart.data.datasets[0].pointRadius = pointRadii;
            tradeoffChart.data.datasets[0].pointBackgroundColor = pointColors;
            tradeoffChart.data.datasets[1].pointRadius = pointRadii;
            tradeoffChart.data.datasets[1].pointBackgroundColor = loadPointColors;
            
            tradeoffChart.update('none');
        }

        // Live 60fps Canvas Animation Loop
        function renderCanvasFrame() {
            animTime += 0.04;

            const targetConc = parseFloat(concSlider.value);
            currentConcSmooth += (targetConc - currentConcSmooth) * 0.12;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            const centerX = 150;
            const centerY = 130;
            const baseRadius = 45;

            // Background Grid Lines
            ctx.strokeStyle = '#dbeafe';
            ctx.lineWidth = 1;
            for (let x = 0; x < canvas.width; x += 20) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, canvas.height);
                ctx.stroke();
            }

            // Magnet Rendering
            const magnetX = 330;
            const magnetY = centerY - 32;
            const magnetPulse = Math.sin(animTime * 2) * 2;

            ctx.fillStyle = '#2563eb';
            ctx.fillRect(magnetX, magnetY - magnetPulse/2, 25, 64 + magnetPulse);
            ctx.fillStyle = '#64748b';
            ctx.fillRect(magnetX + 25, magnetY - magnetPulse/2, 25, 64 + magnetPulse);
            
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 12px sans-serif';
            ctx.fillText('N', magnetX + 8, magnetY + 36);
            ctx.fillText('S', magnetX + 33, magnetY + 36);

            ctx.fillStyle = '#334155';
            ctx.font = '10px sans-serif';
            ctx.fillText('네오디뮴 자석', magnetX - 5, magnetY - 10);

            // Field Lines Animation
            const fieldOffset = (animTime * 25) % 30;
            ctx.strokeStyle = 'rgba(37, 99, 235, 0.35)';
            ctx.lineWidth = 1.5;
            ctx.setLineDash([5, 5]);

            for (let r = 20; r <= 90; r += 25) {
                ctx.beginPath();
                const radiusAnimated = Math.max(10, r - (fieldOffset * 0.5));
                ctx.arc(magnetX, centerY, radiusAnimated, Math.PI * 0.65, Math.PI * 1.35);
                ctx.stroke();
            }
            ctx.setLineDash([]);

            // Draw Gelatinous Wobbling Ooho
            const stretch = (currentConcSmooth * 6); 
            const isRuptured = (currentConcSmooth >= 5.5);

            ctx.save();

            if (isRuptured) {
                ctx.beginPath();
                ctx.ellipse(centerX + stretch/2, centerY + 22, baseRadius + 22, baseRadius - 28, 0, 0, 2 * Math.PI);
                ctx.fillStyle = 'rgba(30, 58, 138, 0.75)';
                ctx.fill();
                ctx.lineWidth = 3;
                ctx.strokeStyle = '#1d4ed8';
                ctx.stroke();

                for (let i = 0; i < 5; i++) {
                    const dropX = centerX + 10 + i * 18 + Math.sin(animTime + i) * 3;
                    const dropY = centerY + 28 + Math.cos(animTime * 1.5 + i) * 2;
                    ctx.beginPath();
                    ctx.arc(dropX, dropY, 3, 0, 2 * Math.PI);
                    ctx.fillStyle = '#1e3a8a';
                    ctx.fill();
                }

            } else {
                ctx.beginPath();
                const points = 16;
                const rx = baseRadius + stretch/2;
                const ry = Math.max(18, baseRadius - stretch/5);
                const shiftX = centerX + stretch/2;

                for (let i = 0; i <= points; i++) {
                    const angle = (i / points) * Math.PI * 2;
                    const wobble = Math.sin(animTime * 3 + angle * 2) * (2 + currentConcSmooth * 0.6);
                    const currRx = rx + wobble;
                    const currRy = ry + wobble * 0.5;

                    const px = shiftX + Math.cos(angle) * currRx;
                    const py = centerY + Math.sin(angle) * currRy;

                    if (i === 0) ctx.moveTo(px, py);
                    else ctx.lineTo(px, py);
                }
                ctx.closePath();

                const darkness = Math.min(0.88, 0.2 + (currentConcSmooth * 0.12));
                ctx.fillStyle = `rgba(15, 23, 42, ${darkness})`;
                ctx.fill();

                ctx.lineWidth = 3;
                ctx.strokeStyle = currentConcSmooth > 4.2 ? '#0284c7' : '#2563eb';
                ctx.stroke();

                ctx.beginPath();
                ctx.ellipse(shiftX - rx*0.4, centerY - ry*0.4, rx*0.25, ry*0.15, -Math.PI/6, 0, 2*Math.PI);
                ctx.fillStyle = 'rgba(255, 255, 255, 0.35)';
                ctx.fill();
            }

            // Internal Particles Dynamic Simulation
            const particleCount = Math.floor(currentConcSmooth * 9);
            ctx.fillStyle = '#0b192c';
            for (let i = 0; i < particleCount; i++) {
                const pAngle = i * 1.35 + animTime * 0.2;
                const pDist = (Math.sin(i * 2.1) * 0.5 + 0.5) * (baseRadius - 12);
                const px = (centerX + stretch/2) + Math.cos(pAngle) * (pDist + stretch/3);
                const py = (isRuptured ? centerY + 20 : centerY) + Math.sin(pAngle) * (pDist * 0.6);
                
                ctx.beginPath();
                ctx.arc(px, py, 2.2, 0, 2 * Math.PI);
                ctx.fill();
            }

            ctx.restore();

            ctx.fillStyle = '#0f172a';
            ctx.font = 'bold 11px sans-serif';
            ctx.fillText(`자성 오호 (농도 ${currentConcSmooth.toFixed(1)}%)`, centerX - 30, centerY + baseRadius + 22);

            if (isRuptured) {
                ctx.fillStyle = '#1d4ed8';
                ctx.font = 'bold 12px sans-serif';
                ctx.fillText('⚠️ 막 파열 (Membrane Ruptured)', centerX - 40, centerY - 15);
            }

            animFrameId = requestAnimationFrame(renderCanvasFrame);
        }

        // Update UI based on slider
        function updateUI() {
            const conc = parseFloat(concSlider.value);
            
            concValue.classList.remove('value-updated');
            void concValue.offsetWidth;
            concValue.classList.add('value-updated');
            concValue.textContent = `${conc.toFixed(1)} wt%`;

            const data = getDataForConc(conc);

            calcDistance.classList.remove('value-updated');
            void calcDistance.offsetWidth;
            calcDistance.classList.add('value-updated');
            calcDistance.textContent = `${data.dist} cm`;

            calcLoad.classList.remove('value-updated');
            void calcLoad.offsetWidth;
            calcLoad.classList.add('value-updated');
            calcLoad.textContent = `${data.load} g`;

            statusAlert.textContent = `ⓘ ${data.status}`;
            statusAlert.className = `p-3 rounded-lg text-xs font-medium border transition-all duration-300 ${data.alertClass}`;

            updateChartHighlight(conc);
        }

        // Set slider value from button or row click
        function setSliderValue(val) {
            concSlider.value = val;
            updateUI();
        }

        // Event Listeners & Initialization
        document.addEventListener('DOMContentLoaded', () => {
            initChart();
            updateUI();

            concSlider.addEventListener('input', updateUI);

            if (animFrameId) cancelAnimationFrame(animFrameId);
            animFrameId = requestAnimationFrame(renderCanvasFrame);
        });
    </script>
</body>
</html>
